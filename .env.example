# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pentashield:pentashield_secret@postgres:5432/pentashield
POSTGRES_USER=pentashield
POSTGRES_PASSWORD=pentashield_secret
POSTGRES_DB=pentashield

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── External APIs ────────────────────────────────────────────────────────────
SHODAN_API_KEY=your-shodan-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
NVD_API_KEY=your-nvd-api-key

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
